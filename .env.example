APP_NAME="OSSZ Collections"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE='Africa/Douala'
APP_URL=https://osszcollection.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ossz
DB_USERNAME=ossz
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# Set on HTTPS hosts so session cookies carry the Secure flag.
# (SchemeAwareCookies middleware auto-resolves this per request:
# HTTPS -> SameSite=None; Secure; Partitioned, HTTP -> Lax non-Secure.)
SESSION_SECURE_COOKIE=true

# Escape hatch: set to 0 to force SameSite=Lax / non-Secure cookies
# regardless of the request scheme (mirrors the Next.js app).
#COOKIE_CROSS_SITE=0

# Optional image CDN (without it, uploads store locally — run
# `php artisan storage:link` once, or rely on /media/{path} serving).
IMAGEKIT_PRIVATE_KEY=

# Concierge (optional — the chat falls back to the knowledge base without keys)
GEMINI_API_KEY=
GEMINI_API_KEY2=

# Transactional email (optional — without it, emails stay queued in the backoffice)
RESEND_API_KEY=
RESEND_FROM="OSSZ Collections <hello@osszcollection.com>"
