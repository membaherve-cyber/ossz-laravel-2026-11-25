<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to hidden files (.env, .git, etc.)
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Block direct access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor)($|/) - [F,L]

    # Rewrite all requests to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
